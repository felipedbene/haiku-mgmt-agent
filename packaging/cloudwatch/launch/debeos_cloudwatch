# launch_daemon job for the packaged debeos-cloudwatch metrics daemon. Ships
# inside the hpkg as data/launch/debeos_cloudwatch, so packagefs exposes it at
# /boot/system/data/launch/debeos_cloudwatch and launch_daemon starts it on
# every boot -- the metrics are default-on with no per-instance configuration.
#
# - "service": launch_daemon restarts it if it dies (a crashed metrics daemon
#   means a blind instance).
# - "legacy": a POSIX daemon, not a launch-aware BApplication, so launch_daemon
#   must not create and hand over a default port.
# - No network condition: the daemon retries IMDSv2 for ~2 min at startup and
#   also fixes the 1970 boot clock itself (needed for TLS/SigV4).
#
# It publishes to CloudWatch namespace DeBeOS/Host every 60s and needs
# cloudwatch:PutMetricData on the instance role (CloudWatchAgentServerPolicy or
# an equivalent grant). It does NOT touch SSM, so it never contends with the
# amazon-ssm-agent's node registration / Run Command channel.
#
# Override the interval/namespace by appending e.g. `--interval 30` or
# `--namespace DeBeOS/HostDev` to the launch line.
#
# CloudWatch Logs is OPT-IN and off by default (adding it would create a log
# group and incur log-ingest cost on every fleet instance). To also tail the
# syslog into CloudWatch Logs, append `--logs` (optionally
# `--logs-source /var/log/syslog --logs-group DeBeOS/syslog --logs-interval 30`).
# It runs on the same thread as the metrics loop and makes no SSM calls, so it
# never contends with the amazon-ssm-agent. Needs logs:CreateLogGroup/
# CreateLogStream/PutLogEvents (also in CloudWatchAgentServerPolicy).

service x-vnd.debeos-cloudwatch {
	launch /boot/system/bin/debeos-cloudwatch
	legacy
}
