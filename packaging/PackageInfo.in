name			haiku_mgmt_agent
version			@VERSION@
architecture		@ARCH@
summary			"SSM-compatible management agent for Haiku on EC2"
description		"Native AWS Systems Manager agent for Haiku on EC2 Graviton.
The instance registers as an SSM managed node and runs AWS-RunShellScript
documents; the agent also provides native S3 transfer (s3 cp), S3 command
output, self-update, and command cancellation. Self-contained: static mbedTLS,
own HTTP/SigV4/JSON, bundled trust anchors." ;
vendor			"DeBeOS"
packager		"DeBeOS <https://github.com/felipedbene/haiku-mgmt-agent>"
copyrights		{ "2026 Felipe de Bene and DeBeOS contributors" }
licenses		{ "MIT" }

provides {
	haiku_mgmt_agent = @PLAIN_VERSION@
	cmd:haiku_mgmt_agent = @PLAIN_VERSION@
}

requires {
	haiku
}
