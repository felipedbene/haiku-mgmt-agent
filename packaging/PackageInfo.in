name			debeos_ssm_agent
version			@VERSION@
architecture		@ARCH@
summary			"Independent, unofficial SSM-compatible agent for DeBeOS on EC2"
description		"Native AWS Systems Manager-compatible management agent for DeBeOS
on EC2 Graviton. The instance registers as a managed node and runs
AWS-RunShellScript documents, Session Manager, Patch Manager, native S3
transfer (s3 cp), S3 command output, self-update, and command cancellation.
F7/#119: publishes host metrics (CPU/memory/disk/network/threads) to CloudWatch
namespace DeBeOS/Host from Haiku's own kernel counters -- the CPUUtilization is
the true busy%, not the hypervisor number that under-reports a Haiku/arm64 guest
by ~55x (DeBeOS #140). Self-contained: static mbedTLS, own HTTP/SigV4/JSON,
bundled trust anchors." ;
vendor			"DeBeOS"
packager		"DeBeOS <https://github.com/felipedbene/haiku-mgmt-agent>"
copyrights		{ "2026 Felipe de Bene and DeBeOS contributors" }
licenses		{ "MIT" }

provides {
	debeos_ssm_agent = @PLAIN_VERSION@
	cmd:debeos_ssm_agent = @PLAIN_VERSION@
}

requires {
	haiku
}
